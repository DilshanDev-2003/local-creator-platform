<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Discover local artists, photographers and craftspeople, browse their portfolios and request custom work.">
  <title><%= typeof title !== 'undefined' ? title + ' · Creator Showcase' : 'Local Creator Showcase' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%
    const path = typeof currentPath !== 'undefined' ? currentPath : '';
    const active = (prefix) => (prefix === '/' ? path === '/' : path === prefix || path.startsWith(prefix + '/'));
    const link = (prefix, href, label) =>
      `<li class="nav-item"><a class="nav-link${active(prefix) ? ' active' : ''}" href="${href}"${active(prefix) ? ' aria-current="page"' : ''}>${label}</a></li>`;
  %>
  <a class="visually-hidden-focusable position-absolute bg-white p-2 m-2 rounded" href="#main">Skip to main content</a>

  <nav class="navbar navbar-expand-lg bg-white border-bottom" aria-label="Main navigation">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">Creator<span class="text-primary">Showcase</span></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
              data-bs-target="#mainNav" aria-controls="mainNav"
              aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav me-auto">
          <%- link('/', '/', 'Home') %>
          <%- link('/categories', '/categories', 'Categories') %>
          <%- link('/creators', '/creators', 'Creators') %>
          <% if (currentUser && currentUser.role === 'creator') { %>
            <%- link('/creator', '/creator/dashboard', 'Dashboard') %>
          <% } %>
          <% if (currentUser && currentUser.role !== 'admin') { %>
            <%- link('/my-commissions', '/my-commissions', 'My Commissions') %>
          <% } %>
          <% if (currentUser && currentUser.role === 'admin') { %>
            <%- link('/admin', '/admin', 'Admin') %>
          <% } %>
        </ul>
        <div class="d-flex align-items-center gap-2">
          <% if (currentUser) { %>
            <span class="text-muted small">Hi, <%= currentUser.name %> (<%= currentUser.role %>)</span>
            <form action="/logout" method="POST" class="m-0">
              <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
            </form>
          <% } else { %>
            <a href="/login" class="btn btn-outline-primary btn-sm">Login</a>
            <a href="/register" class="btn btn-primary btn-sm">Sign up</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>
  <main id="main" class="container py-4 main-content">